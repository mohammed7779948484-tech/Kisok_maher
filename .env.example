# Database - Neon PostgreSQL
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?pgbouncer=true&sslmode=require"

# Payload CMS
PAYLOAD_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
NEXT_PUBLIC_SERVER_URL="http://localhost:3000"

# Authentication
SESSION_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
GATE_PASSWORD="replace-with-a-strong-access-password"

# Cloudinary
CLOUDINARY_CLOUD_NAME="your-cloud-name"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Sentry
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# Cron (generate a random string, for example with: openssl rand -base64 16)
CRON_SECRET=""

# App
NODE_ENV="development"
PORT="3000"
LOG_LEVEL="info"

# Optional: Seed credentials
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="replace-with-a-strong-unique-password"
WHATSAPP_NUMBER="+15550199999"
